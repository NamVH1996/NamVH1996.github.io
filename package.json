{
  "name": "grafana-all-in-one-plugin",
  "version": "1.0.0",
  "description": "All-in-one Grafana Plugin App for unified monitoring",
  "main": "dist/module.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "test": "jest",
    "lint": "eslint --ext .ts,.tsx src/",
    "format": "prettier --write 'src/**/*.{ts,tsx,json,md}'",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["grafana", "plugin", "monitoring", "dashboard"],
  "author": "",
  "license": "Apache 2.0",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@grafana/data": "^11.0.0",
    "@grafana/ui": "^11.0.0",
    "@grafana/runtime": "^11.0.0",
    "axios": "^1.7.7"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.5",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^7.13.1",
    "@typescript-eslint/parser": "^7.13.1",
    "css-loader": "^7.1.2",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.3",
    "style-loader": "^4.0.0",
    "ts-jest": "^29.1.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.2",
    "webpack": "^5.95.0",
    "webpack-cli": "^5.1.4"
  }
