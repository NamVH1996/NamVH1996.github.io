  "description": "All-in-one Grafana Plugin App for unified monitoring",
  "main": "dist/module.js",
  "scripts": {
    "dev": "webpack --mode development --watch",
    "build": "webpack --mode production",
    "test": "jest",
    "lint": "eslint --ext .ts,.tsx src/",
